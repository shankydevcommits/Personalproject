# Copy this file to .env.local for local development.
# In production (Vercel), add each of these under Project Settings -> Environment Variables.
# See SETUP-GUIDE.md for exactly where each value comes from.

# ---- Site ----
# The full public URL of the deployed site, no trailing slash.
SITE_URL=https://your-househq-site.vercel.app

# ---- Supabase (database + private file storage) ----
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. SECRET - server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Name of the private Storage bucket the PDFs are uploaded into.
SUPABASE_STORAGE_BUCKET=checklists

# ---- Stripe (payments) ----
# SECRET - server-side only.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create, see SETUP-GUIDE.md.
STRIPE_WEBHOOK_SECRET=

# ---- Resend (transactional + marketing email) ----
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend, e.g. orders@yourdomain.com.au
EMAIL_FROM="HouseHQ <orders@yourdomain.com.au>"
# Where "Contact Us" form submissions get emailed to.
CONTACT_NOTIFY_EMAIL=you@yourdomain.com.au

# ---- Security ----
# Any long random string, used to sign unsubscribe links. Generate one with:
# openssl rand -hex 32
UNSUBSCRIBE_SECRET=
